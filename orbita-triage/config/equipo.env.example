# Copiar a .env (raíz del repo o ruta acordada). No commitear secretos.
# Valores de ejemplo; sustituir por los reales del equipo Órbita.

# --- Turnos / contacto ---
ORBITA_ONCALL_PRIMARY=@slack-id-o-email
ORBITA_ONCALL_SECONDARY=@slack-id-o-email
ORBITA_ESCALATION_MINUTES=30

# --- AWS (solo nombres públicos; credenciales vía perfil CLI o SSO) ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- CloudWatch (grupos de logs típicos; uno por línea conceptual) ---
# CW_LOG_GROUP_API=/aws/ecs/orbita-api
# CW_LOG_GROUP_WORKER=/aws/lambda/orbita-worker

# --- Integraciones opcionales (URLs sin tokens; tokens en secret manager) ---
# JIRA_BASE_URL=https://tu-dominio.atlassian.net
# JIRA_PROJECT=ORBITA
